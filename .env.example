# Server only. Run the migrations in supabase/migrations first.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-server-only-service-role-key

# Optional separate session signing key. When absent, one is derived from the
# Supabase secret key. Keep it stable so 60-day sessions survive deployments.
# ACCESS_SESSION_SECRET=replace-with-at-least-32-random-characters
